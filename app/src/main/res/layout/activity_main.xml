<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background" android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingLeft="22dp" android:paddingTop="22dp"
        android:paddingRight="22dp" android:paddingBottom="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="54dp" android:layout_height="62dp"
                android:contentDescription="" android:src="@drawable/ic_building" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium" android:letterSpacing="0.14" android:text="APT ACCESS"
                    android:textColor="@color/text_primary" android:textSize="21sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="3dp" android:fontFamily="sans-serif-light" android:letterSpacing="0.14"
                    android:text="A SUA ENTRADA, SEMPRE CONSIGO." android:textColor="@color/text_secondary" android:textSize="9sp" />
            </LinearLayout>
            <Button android:id="@+id/settingsButton" android:layout_width="52dp" android:layout_height="52dp"
                android:background="@drawable/button_secondary" android:contentDescription="Definições"
                android:drawableTop="@drawable/ic_settings" android:text="" android:textAllCaps="false" />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="18dp" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="206dp"
            android:background="@drawable/card_background" android:clipToOutline="true">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                android:contentDescription="Entrada da residência" android:scaleType="centerCrop"
                android:src="@drawable/residence_entrance" />
            <View android:layout_width="match_parent" android:layout_height="95dp"
                android:layout_gravity="bottom" android:background="@drawable/photo_overlay" />
            <TextView android:id="@+id/residenceStatus" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_gravity="bottom|start" android:layout_margin="16dp"
                android:fontFamily="sans-serif-medium" android:lineSpacingExtra="3dp"
                android:text="Minha Residência\n●  Online" android:textColor="@android:color/white"
                android:textSize="15sp" />
        </FrameLayout>
        <Space android:layout_width="1dp" android:layout_height="18dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:id="@+id/openApartmentButton" android:layout_width="0dp" android:layout_height="166dp"
                android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/button_primary"
                android:clickable="true" android:clipToOutline="true" android:contentDescription="Abrir porta do apartamento"
                android:elevation="4dp" android:focusable="true" android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center" android:orientation="vertical" android:padding="10dp">
                <FrameLayout android:layout_width="72dp" android:layout_height="72dp">
                    <View android:layout_width="72dp" android:layout_height="72dp" android:background="@drawable/halo_blue" />
                    <ImageView android:layout_width="38dp" android:layout_height="38dp" android:layout_gravity="center"
                        android:contentDescription="" android:src="@drawable/ic_apartment_door" />
                </FrameLayout>
                <TextView android:id="@+id/aptActionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                    android:gravity="center" android:text="Abrir Porta" android:textColor="@android:color/white" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:id="@+id/aptActionState" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                    android:letterSpacing="0.12" android:text="APT" android:textColor="#DDE7FF" android:textSize="13sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:id="@+id/openBuildingButton" android:layout_width="0dp" android:layout_height="166dp"
                android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/button_green"
                android:clickable="true" android:clipToOutline="true" android:contentDescription="Abrir porta do prédio"
                android:elevation="4dp" android:focusable="true" android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center" android:orientation="vertical" android:padding="10dp">
                <FrameLayout android:layout_width="72dp" android:layout_height="72dp">
                    <View android:layout_width="72dp" android:layout_height="72dp" android:background="@drawable/halo_gold" />
                    <ImageView android:layout_width="38dp" android:layout_height="38dp" android:layout_gravity="center"
                        android:contentDescription="" android:src="@drawable/ic_apartment_door" />
                </FrameLayout>
                <TextView android:id="@+id/bldActionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                    android:gravity="center" android:text="Abrir Porta" android:textColor="@android:color/white" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:id="@+id/bldActionState" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                    android:letterSpacing="0.12" android:text="BLD" android:textColor="#DDF6E3" android:textSize="13sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="12dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:id="@+id/lockButton" android:layout_width="0dp" android:layout_height="112dp"
                android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/action_card_background"
                android:clickable="true" android:clipToOutline="true" android:contentDescription="Trancar porta do apartamento"
                android:elevation="1dp" android:focusable="true" android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center" android:orientation="vertical" android:padding="12dp">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:contentDescription="" android:src="@drawable/ic_lock" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:text="Lock" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="(opcional)"
                    android:textColor="@color/text_secondary" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/unlockButton" android:layout_width="0dp" android:layout_height="112dp"
                android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/action_card_background"
                android:clickable="true" android:clipToOutline="true" android:contentDescription="Destrancar porta do apartamento"
                android:elevation="1dp" android:focusable="true" android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center" android:orientation="vertical" android:padding="12dp">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:contentDescription="" android:src="@drawable/ic_unlock" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:text="Unlock" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="(opcional)"
                    android:textColor="@color/text_secondary" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="18dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/status_background" android:gravity="center_vertical"
            android:orientation="horizontal" android:paddingHorizontal="18dp" android:paddingVertical="17dp">
            <ImageView android:layout_width="34dp" android:layout_height="34dp"
                android:contentDescription="Estado da rede" android:src="@drawable/ic_wifi" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/connectivityText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Ligado ao serviço" android:textColor="@color/text_primary" android:textSize="14sp" />
                <TextView android:id="@+id/statusText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Pronto" android:textColor="@color/text_secondary" android:textSize="14sp" />
            </LinearLayout>
            <ProgressBar android:id="@+id/progressBar" style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:letterSpacing="0.18" android:paddingTop="18dp"
            android:text="—  SEGURANÇA NA PALMA DA SUA MÃO  —"
            android:textColor="#8A8985" android:textSize="8sp" />
    </LinearLayout>
</ScrollView>
