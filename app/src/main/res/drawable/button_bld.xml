<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient android:angle="315" android:startColor="#30210F" android:centerColor="#65401A" android:endColor="#8B571E" />
            <stroke android:width="1dp" android:color="#D49B48" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="315" android:startColor="#241B10" android:centerColor="#4A321A" android:endColor="#735024" />
            <stroke android:width="1dp" android:color="#9D7440" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</selector>
